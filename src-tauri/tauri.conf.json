{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grade 9 Tracker",
  "version": "1.0.0",
  "identifier": "uk.alastair.grade9tracker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Grade 9 Tracker",
        "width": 1000,
        "height": 820,
        "minWidth": 420,
        "minHeight": 600,
        "backgroundColor": "#F4F5F7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; ipc-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
