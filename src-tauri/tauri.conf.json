{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zelinx Study Planner",
  "version": "1.36.1",
  "identifier": "app.zelinx.studyplanner",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Zelinx Study Planner",
        "width": 1000,
        "height": 820,
        "minWidth": 420,
        "minHeight": 600,
        "backgroundColor": "#F4F5F7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; media-src 'self' data:; frame-src https://www.youtube-nocookie.com; ipc-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "publisher": "Zelinx",
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/tts/**/*"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/PirusPoker/Grade9Tracker/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCMEZGNTA4NTdEQkI5QUQKUldTdHVkdFhDUFVQSytGU2RyNXpWL29DQk9wUEhabEtGZmNqUkVGWUZlcm05MjdkQk9hT3hxcFIK"
    }
  }
}
