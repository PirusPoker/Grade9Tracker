{
  "manifest_version": 3,
  "name": "Grade 9 Tracker — Teams assignment sync",
  "version": "1.0.0",
  "description": "Reads your Microsoft Teams assignments and syncs them into Grade 9 Tracker on this computer. Nothing leaves your machine.",
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://127.0.0.1:47814/*", "http://localhost:47814/*"],
  "content_scripts": [
    {
      "matches": ["https://teams.microsoft.com/*", "https://*.teams.microsoft.com/*", "https://teams.cloud.microsoft/*", "https://*.cloud.microsoft/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://teams.microsoft.com/*", "https://*.teams.microsoft.com/*", "https://teams.cloud.microsoft/*", "https://*.cloud.microsoft/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
